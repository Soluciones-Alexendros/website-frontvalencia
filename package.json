{
  "name": "frontvalencia",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "FRONT Valencia — Restaurante y Terraza en La Marina de Valencia. TypeScript monorepo (Payload CMS + Astro).",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=8.15.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --parallel",
    "dev:cms": "turbo run dev --filter=cms",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build",
    "build:cms": "turbo run build --filter=cms",
    "build:web": "turbo run build --filter=web",
    "lint": "turbo run lint",
    "format": "prettier --write README.md AGENTS.md ARCHITECTURE.md SECURITY.md CONTRIBUTING.md CODE_OF_CONDUCT.md SUPPORT.md DECISIONS.md docs .github",
    "format:check": "prettier --check README.md AGENTS.md ARCHITECTURE.md SECURITY.md CONTRIBUTING.md CODE_OF_CONDUCT.md SUPPORT.md DECISIONS.md docs .github",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "generate:types": "turbo run //#generate:types",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "preview": "turbo run preview",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "docker:down": "docker compose down -v",
    "docker:reset": "docker compose down -v && docker compose up --build",
    "scrape": "tsx tools/scripts/scrape-content.ts",
    "validate:env": "tsx tools/scripts/validate-env.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@frontvalencia/types": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "turbo": "^2.3.5",
    "typescript": "^5.8.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": ["prettier --write"],
    "*.json": ["prettier --write"],
    "*.css": ["prettier --write"],
    "*.md": ["prettier --write"]
  },
  "keywords": [
    "astro",
    "payload-cms",
    "monorepo",
    "turborepo",
    "pnpm-workspaces",
    "restaurant",
    "valencia",
    "typescript",
    "ssg",
    "seo",
    "accessibility",
    "brutalist",
    "open-source",
    "ai-optimized"
  ],
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=4 <5.0.11": "5.0.11",
      "browserslist": ">=4.28.7",
      "devalue": ">=5.9.3",
      "dompurify": ">=3.4.17",
      "fast-uri": ">=3.1.7",
      "happy-dom": ">=21.0.4",
      "http-cache-semantics": ">=4.3.0",
      "image-size": ">=2.0.3",
      "js-yaml@<4": "3.15.2",
      "js-yaml@>=4": "4.3.2",
      "nanoid@^3": "3.3.18",
      "postcss": ">=8.5.32",
      "sharp": ">=0.35.5",
      "smol-toml": ">=1.7.1",
      "source-map-js": ">=1.2.2",
      "svgo@>=4": ">=4.1.0",
      "undici": ">=7.30.1",
      "vite@>=6 <7": "6.4.5",
      "vite@>=8": ">=8.1.6",
      "zod@>=4": ">=4.6.6"
    }
  }
}
