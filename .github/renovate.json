{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Iniciativas-Alexendros/infraestructura-stack:renovate-presets/default",
    "local>Iniciativas-Alexendros/infraestructura-stack:renovate-presets/node"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    { "matchPackageNames": ["astro*", "@astrojs/*"], "groupName": "Astro" },
    { "matchPackageNames": ["payload", "@payloadcms/*"], "groupName": "Payload CMS" },
    { "matchPackageNames": ["react", "react-dom", "@types/react*"], "groupName": "React" },
    { "matchPackageNames": ["tailwindcss", "@tailwindcss/*"], "groupName": "Tailwind" },
    { "matchPackageNames": ["vitest", "@playwright/*", "playwright"], "groupName": "Testing" },
    { "matchPackageNames": ["sharp"], "allowedVersions": "<0.36.0" }
  ]
}
